# MemoryBridge Environment Variables
PORT=5000
LOG_LEVEL=INFO

# Local Blockchain Configuration (Hardhat)
# Provider URL pointing to the local hardhat dev node
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545

# Deployed Smart Contract Address (Updated automatically on deploy)
CONTRACT_ADDRESS=

# Signing Wallet Private Key
# Below is the default pre-funded Account #0 private key generated by Hardhat local nodes.
# WARNING: NEVER use this private key or hardcode keys on mainnet or production.
WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
